### vars
@baseurl = http://localhost:9001/api/table
@token = uuid xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

### query table records
POST {{baseurl}}/query HTTP/1.1
Content-Type: application/json

{
    "table": "cloudserver_instance",
    "query": {}
}

### query lighthouse
POST {{baseurl}}/query HTTP/1.1
Content-Type: application/json

{
    "table": "lighthouse",
    "query": {
        "region": "ap-guangzhou"
    }
}

### query logservice topic
POST {{baseurl}}/query HTTP/1.1
Content-Type: application/json

{
    "table": "logservice_topic",
    "query": {}
}

### insert new record
POST {{baseurl}}/new HTTP/1.1
Content-Type: application/json

{
    "table": "lighthouse",
    "new": {
        "instance_id": "lhins-xxxxxxxx",
        "instance_name": "test-instance",
        "region": "ap-guangzhou",
        "state": "RUNNING"
    }
}

### update record
POST {{baseurl}}/update HTTP/1.1
Content-Type: application/json

{
    "table": "lighthouse",
    "update": {
        "id": 1,
        "instance_name": "updated-name"
    }
}

### delete record
POST {{baseurl}}/delete HTTP/1.1
Content-Type: application/json

{
    "table": "lighthouse",
    "delete": {
        "id": 1
    }
}
