### vars
@baseurl = http://localhost:9005/api/channel
@token = uuid xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

### get all channel configs
GET {{baseurl}}/get HTTP/1.1
Authorization: {{token}}

### update SMTP channel config
POST {{baseurl}}/update HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "channel_type": "smtp",
    "name": "smtp-main",
    "config_json": {
        "host": "smtp.example.com",
        "port": 587,
        "username": "noreply@example.com",
        "password": "your_password",
        "from": "noreply@example.com",
        "use_tls": true
    },
    "is_enabled": true
}

### update Bark channel config
POST {{baseurl}}/update HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "channel_type": "bark",
    "name": "bark-main",
    "config_json": {
        "server_url": "https://api.day.app/YOUR_KEY",
        "device_key": "YOUR_DEVICE_KEY"
    },
    "is_enabled": true
}

### update Bark channel config (named instance: bark-prod)
POST {{baseurl}}/update HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "channel_type": "bark",
    "name": "bark-prod",
    "config_json": {
        "server_url": "https://api.day.app/PROD_KEY",
        "device_key": "PROD_DEVICE_KEY"
    },
    "is_enabled": true
}
