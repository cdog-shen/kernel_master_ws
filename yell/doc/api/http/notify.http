### vars
@baseurl = http://localhost:9005/api/notify
@token = uuid xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

### send notification (direct recipients)
POST {{baseurl}}/send HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "title": "系统通知",
    "body": "这是一条测试通知",
    "format": "text",
    "priority": "normal",
    "tags": ["test", "demo"],
    "url": "https://example.com",
    "mentions": ["user1", "user2"],
    "recipients": [
        {"channel_type": "smtp", "instance": "smtp-main", "recipient": "admin@example.com"},
        {"channel_type": "smtp", "instance": "smtp-main", "recipient": "ops@example.com"}
    ]
}

### send notification with specific instance
POST {{baseurl}}/send HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "title": "告警通知",
    "body": "生产环境 CPU 使用率超过 90%",
    "format": "text",
    "priority": "urgent",
    "recipients": [
        {"channel_type": "bark", "instance": "bark-prod", "recipient": "PROD_DEVICE_KEY"}
    ]
}

### send HTML notification
POST {{baseurl}}/send HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "title": "告警通知",
    "body": "<h1>CPU 使用率超过 90%</h1><p>请及时处理</p>",
    "format": "html",
    "priority": "urgent",
    "recipients": [
        {"channel_type": "smtp", "instance": "smtp-main", "recipient": "oncall@example.com"}
    ]
}

### send SMTP to multiple recipients
POST {{baseurl}}/send HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "title": "系统通知",
    "body": "这是一封群发邮件",
    "format": "text",
    "priority": "normal",
    "recipients": [
        {"channel_type": "smtp", "instance": "smtp-main", "recipient": "user1@example.com, user2@example.com; user3@example.com"}
    ]
}

### send Bark notification
POST {{baseurl}}/send HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "title": "Yell Bark 测试",
    "body": "这是一条来自 Yell 的 Bark 推送",
    "format": "text",
    "priority": "normal",
    "tags": ["test"],
    "url": "https://example.com",
    "recipients": [
        {"channel_type": "bark", "instance": "bark-main", "recipient": "YOUR_DEVICE_KEY"}
    ]
}

### send with template
POST {{baseurl}}/template HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "template_name": "alert_template",
    "variables": {
        "level": "严重",
        "service": "CMDB",
        "message": "数据库连接超时"
    },
    "recipients": [
        {"channel_type": "smtp", "instance": "smtp-main", "recipient": "devops@example.com"}
    ]
}

### send via alias (recipients as string)
POST {{baseurl}}/send HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "title": "系统通知",
    "body": "这是一条通过 alias 发送的通知",
    "format": "text",
    "priority": "normal",
    "recipients": "ops-team"
}

### send with template via alias
POST {{baseurl}}/template HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "template_name": "alert_template",
    "variables": {
        "level": "严重",
        "service": "CMDB",
        "message": "数据库连接超时"
    },
    "recipients": "ops-team"
}

### send Bark urgent alert (预置模板 bark_urgent_alert)
POST {{baseurl}}/template HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "template_name": "bark_urgent_alert",
    "variables": {
        "level": "严重",
        "service": "CMDB",
        "message": "生产环境 CPU 使用率超过 95%，请立即处理",
        "group": "cmdb-alerts",
        "url": "https://monitor.example.com/alert/123"
    },
    "recipients": [
        {"channel_type": "bark", "instance": "cdog_main_bark", "recipient": "YOUR_DEVICE_KEY"}
    ]
}

### send Bark silent notification (预置模板 bark_silent)
POST {{baseurl}}/template HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "template_name": "bark_silent",
    "variables": {
        "title": "日报提醒",
        "message": "今日日报尚未提交，请尽快完成",
        "group": "daily-report"
    },
    "recipients": [
        {"channel_type": "bark", "instance": "cdog_main_bark", "recipient": "YOUR_DEVICE_KEY"}
    ]
}

