### send all channels alert (全渠道模板)
POST {{baseurl}}/template HTTP/1.1
Authorization: {{token}}
Content-Type: application/json

{
    "template_name": "all_channels_alert",
    "variables": {
        "level": "严重",
        "service": "CMDB",
        "message": "生产环境数据库连接超时",
        "group": "cmdb-alerts",
        "url": "https://monitor.example.com/alert/456"
    },
    "recipients": [
        {"channel_type": "smtp", "instance": "smtp-main", "recipient": ["ops@example.com"]},
        {"channel_type": "bark", "instance": "bark-main", "recipient": ["YOUR_DEVICE_KEY"]},
        {"channel_type": "gotify", "instance": "gotify-main", "recipient": ["YOUR_APP_TOKEN"]},
        {"channel_type": "teams", "instance": "teams-main", "recipient": [""]},
        {"channel_type": "webhook", "instance": "webhook-main", "recipient": [""]}
    ]
}
